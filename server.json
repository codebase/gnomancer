{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.gnomancer/gnomancer",
  "description": "Local raw DNA analysis: haplogroups, traits, ClinVar, pharmacogenomics. Nothing is uploaded.",
  "title": "gnomancer",
  "websiteUrl": "https://gnomancer.com",
  "repository": {
    "url": "https://github.com/codebase/gnomancer",
    "source": "github"
  },
  "version": "0.3.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "gnomancer",
      "version": "0.3.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
